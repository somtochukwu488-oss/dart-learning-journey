int calculateTotal(List<int> score) {
  int total = 0;

  for (int i = 0; i < score.length; i++) {
    total = total + score[i];
  }

  return total;
}

double calculateAverage(int total, int numberOfSubjects) {
  return total / numberOfSubjects;
}

void main() {
  String name = 'Sandra';
  String studentClass = 'SS2';

  List<String> subject = [
    'Mathematics',
    'English',
    'Biology',
    'Chemistry',
    'Physics',
  ];

  List<int> score = [30, 40, 35, 25, 45];

  int totalScore = calculateTotal(score);
  double averageScore = calculateAverage(totalScore, subject.length);
  String grade = getGrade(averageScore);
  String remark = getRemark(averageScore);
  String result = checkResult(averageScore);
  displayReport(
    name: name,
    studentClass: studentClass,
    subject: subject,
    score: score,
    totalScore: totalScore,
    averageScore: averageScore,
    grade: grade,
    remark: remark,
