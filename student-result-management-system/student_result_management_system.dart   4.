String getGrade(double average) {
  if (average >= 70) {
    return 'A';
  } else if (average >= 60) {
    return 'B';
  } else if (average >= 50) {
    return 'C';
  } else if (average >= 45) {
    return 'D';
  } else {
    return 'F';
  }
}

String getRemark(double average) {
  if (average >= 70) {
    return 'Excellent';
  } else if (average >= 60) {
    return 'Very Good';
  } else if (average >= 50) {
    return 'Good';
  } else if (average >= 45) {
    return 'Pass';
  } else {
    return 'Fail';
  }
}

String checkResult(double average) {
  if (average >= 45) {
    return 'Passed';
  } else {
    return 'Failed';
  }
}

void displayReport({
  required String name,
  required String studentClass,
  required List<String> subject,
  required List<int> score,
  required int totalScore,
  required double averageScore,
  required String grade,
  required String remark,
  required String result,
}) {
  print('STUDENT RESULT');
  print('============================');
  print('Name: $name');
  print('Class: $studentClass');
  print('Subjects: $subject');
  print('Scores: $score');
  print('Total Score: $totalScore');
  print('Average Score: $averageScore');
  print('Grade: $grade');
  print('Remark: $remark');
  print('Result: $result');
}
